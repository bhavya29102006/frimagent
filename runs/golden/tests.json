    },
    {
      "id": "T08",
      "name": "Sensor Failure Disconnected",
      "category": "sensor_failure",
      "sensor": "disconnected",
      "steps": [
        {
          "set_temp": null,
          "wait_ms": 2500
        }
      ],
      "expect": [
        {
          "serial_contains": "[ERROR] SENSOR_FAIL",
          "spec_ref": "R5"
        },
        {
          "serial_contains": "fan=ON",
          "spec_ref": "R5"
        }
      ],
      "must_not": [],
      "rationale": "Verify fail-safe behavior prints SENSOR_FAIL and turns fan ON when sensor is disconnected.",
      "round": 0
    },
    {
      "id": "T09",
      "name": "Thermal Recovery from Overheat",
      "category": "recovery",
      "sensor": "normal",
      "steps": [
        {
          "set_temp": 65.0,
          "wait_ms": 2500
        },
        {
          "set_temp": 25.0,
          "wait_ms": 2500
        }
      ],
      "expect": [
        {
          "serial_contains": "[ALARM] OVERHEAT",
          "spec_ref": "R4"
        },
        {
          "serial_contains": "temp=25.0 fan=OFF",
          "spec_ref": "R3"
        }
      ],
      "must_not": [],
      "rationale": "Verify system recovers from extreme overheat condition (65.0 C) back down to room temp (25.0 C).",
      "round": 0
    },
    {
      "id": "T10",
      "name": "Hysteresis Sequence Step to 29.0 C",
      "category": "sequence",
      "sensor": "normal",
      "steps": [
        {
          "set_temp": 31.0,
          "wait_ms": 2500
        },
        {
          "set_temp": 29.0,
          "wait_ms": 2500
        }
      ],
      "expect": [
        {
          "serial_contains": "temp=31.0 fan=ON",
          "spec_ref": "R1"
        },
        {
          "serial_contains": "temp=29.0 fan=ON",
          "spec_ref": "R2"
        }
      ],
      "must_not": [],
      "rationale": "Verify 2 C hysteresis: transitioning from 31.0 C to 29.0 C keeps the fan ON.",
      "round": 0
    },
    {
