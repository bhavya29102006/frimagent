      "sensor": "normal",
      "steps": [
        {
          "set_temp": 25.0,
          "wait_ms": 2500
        }
      ],
      "expect": [
        {
          "serial_contains": "temp=25.0 fan=OFF",
          "spec_ref": "R3"
        }
      ],
      "must_not": [],
      "rationale": "Verify fan remains OFF at room temperature (25.0 C).",
      "round": 0
    },
