        },
        {
          "serial_contains": "temp=28.0 fan=OFF",
          "spec_ref": "R2"
        }
      ],
      "must_not": [],
      "rationale": "Verify hysteresis rule: dropping down to 28.0 C finally turns the fan OFF.",
      "round": 0
    },
