    {
      "id": "T06",
      "name": "Abnormal Minimum DHT22 Range",
      "category": "abnormal",
      "sensor": "normal",
      "steps": [
        {
          "set_temp": -40.0,
          "wait_ms": 2500
        }
      ],
      "expect": [
        {
          "serial_contains": "temp=-40.0 fan=OFF",
